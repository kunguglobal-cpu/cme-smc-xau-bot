from bot.logger import log_signal
from bot.market_structure import MarketStructureDetector
from bot.fvg_detector import FairValueGapDetector
from bot.order_block_detector import OrderBlockDetector
from bot.liquidity_sweep import LiquiditySweepDetector
from cme_reader import CMEReader


class SignalEngine:

    CME_TOLERANCE = 0.10

    def __init__(self):
        self.market = MarketStructureDetector()
        self.fvg = FairValueGapDetector()
        self.ob = OrderBlockDetector()
        self.liquidity = LiquiditySweepDetector()
        self.cme = CMEReader()

    def _cme_context(self, price, cme_snapshot):
             if isinstance(price, (list, tuple)):
            price = price[-1]  
       """ Determine whether price is near a CME expected-range level.

        Returns:
            {
                "zone": "1sigma_lower" / "1sigma_upper" / None,
                "distance": float,
                "level": float
            }
        """

        if not cme_snapshot:
            return {
                "zone": None,
                "distance": None,
                "level": None
            }

        levels = cme_snapshot.get("levels", {})

        lower = levels.get("1sigma_lower")
upper = levels.get("1sigma_upper")

if isinstance(lower, (list, tuple)):
    lower = lower[-1]

if isinstance(upper, (list, tuple)):
    upper = upper[-1]

try:
    lower = float(lower)
    upper = float(upper)
except (TypeError, ValueError):
    return {
        "zone": None,
        "distance": None,
        "level": None
    }

        if lower is None or upper is None:
            return {
                "zone": None,
                "distance": None,
                "level": None
            }

        range_size = abs(upper - lower)

        if range_size <= 0:
            return {
                "zone": None,
                "distance": None,
                "level": None
            }

        tolerance = range_size * self.CME_TOLERANCE

        lower_distance = abs(price - lower)
        upper_distance = abs(price - upper)

        if lower_distance <= tolerance:
            return {
                "zone": "1sigma_lower",
                "distance": lower_distance,
                "level": lower
            }

        if upper_distance <= tolerance:
            return {
                "zone": "1sigma_upper",
                "distance": upper_distance,
                "level": upper
            }

        return {
            "zone": None,
            "distance": min(lower_distance, upper_distance),
            "level": lower if lower_distance < upper_distance else upper
        }

    def generate_signal(self, o, h, l, c, cme_snapshot=None):

        signal = {
            "direction": None,
            "reason": [],
            "cme_zone": None,
            "cme_level": None
        }

        # ---------------------------------------------------------
        # MARKET STRUCTURE
        # ---------------------------------------------------------

        bos = self.market.detect_bos(h, l)

        if bos:
            signal["reason"].append(bos["type"])

        # ---------------------------------------------------------
        # FAIR VALUE GAP
        # ---------------------------------------------------------

        fvg = self.fvg.detect_fvg(h, l)

        if fvg:
            signal["reason"].append(fvg["type"])

        # ---------------------------------------------------------
        # ORDER BLOCK
        # ---------------------------------------------------------

        bull_ob = self.ob.detect_bullish_ob(o, h, l, c)

        if bull_ob:
            signal["reason"].append("bullish_order_block")

        bear_ob = self.ob.detect_bearish_ob(o, h, l, c)

        if bear_ob:
            signal["reason"].append("bearish_order_block")

        # ---------------------------------------------------------
        # LIQUIDITY SWEEPS
        # ---------------------------------------------------------

        buy_sweep = self.liquidity.detect_buy_side_sweep(h, c)

        if buy_sweep:
            signal["reason"].append("buy_side_sweep")

        sell_sweep = self.liquidity.detect_sell_side_sweep(l, c)

        if sell_sweep:
            signal["reason"].append("sell_side_sweep")

        # ---------------------------------------------------------
        # CME EXPECTED RANGE FILTER
        # ---------------------------------------------------------

        cme = self._cme_context(c, cme_snapshot)

        signal["cme_zone"] = cme["zone"]
        signal["cme_level"] = cme["level"]

        if cme["zone"] == "1sigma_lower":
    signal["reason"].append("cme_1sigma_lower")
elif cme["zone"] == "1sigma_upper":
    signal["reason"].append("cme_1sigma_upper")

        # ---------------------------------------------------------
        # BUY SETUP
        #
        # CME lower range
        # + bullish BOS
        # + bullish FVG OR bullish OB
        # ---------------------------------------------------------

        bullish_confirmation = (
            "bullish_bos" in signal["reason"]
            and (
                "bullish_order_block" in signal["reason"]
                or "bullish_fvg" in signal["reason"]
            )
        )

        if (
            cme["zone"] == "1sigma_lower"
            and bullish_confirmation
        ):
            signal["direction"] = "BUY"

        # ---------------------------------------------------------
        # SELL SETUP
        #
        # CME upper range
        # + bearish BOS
        # + bearish FVG OR bearish OB
        # ---------------------------------------------------------

        bearish_confirmation = (
            "bearish_bos" in signal["reason"]
            and (
                "bearish_order_block" in signal["reason"]
                or "bearish_fvg" in signal["reason"]
            )
        )

        if (
            cme["zone"] == "1sigma_upper"
            and bearish_confirmation
        ):
            signal["direction"] = "SELL"

        # ---------------------------------------------------------
        # LOG + RETURN
        # ---------------------------------------------------------

        log_signal(signal)

        return signal


if __name__ == "__main__":

    # ---------------------------------------------------------
    # TEST CME SNAPSHOT
    # ---------------------------------------------------------

    cme_snapshot = {
        "symbol": "OG",
        "expiry": "G1MQ6",
        "futures_price": 4076.6,
        "atm": 4076.6,
        "volatility": 14.14,
        "levels": {
            "1sigma_upper": 4119.5,
            "1sigma_lower": 4033.7,
            "2sigma_upper": 4163.1,
            "2sigma_lower": 3990.1,
            "3sigma_upper": 4207.1,
            "3sigma_lower": 3946.1
        }
    }

    # ---------------------------------------------------------
    # TEST PRICE DATA
    # ---------------------------------------------------------

    opens = [4030, 4034, 4036]
    highs = [4038, 4042, 4045]
    lows = [4025, 4030, 4032]
    closes = [4035, 4040, 4043]

    engine = SignalEngine()

    result = engine.generate_signal(
        opens,
        highs,
        lows,
        closes,
        cme_snapshot
    )

    print()
    print("=== CME + SMC SIGNAL TEST ===")
    print(result)

